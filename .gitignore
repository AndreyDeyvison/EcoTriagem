# Ambiente virtual Python
.venv/
venv/
env/

# Python
__pycache__/

# Arquivos de ambiente
.env
.env.*

# Python (extras)
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Datasets (grandes; obter via script/instruções do README)
